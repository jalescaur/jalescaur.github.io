---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <div class="banner">
    <img src="/foto.png" alt="Jales Caur" fetchpriority="high" width="2400" height="960" />
    <div class="banner-fade"></div>
  </div>

  <section class="hero">
    <h1>Jales <em>Caur</em></h1>
    <p class="role-line">Doutorando — Relações Internacionais, Universidade de Brasília (IREL/UnB) &middot; Consultor Político &amp; de Dados — BMJ Consultores Associados</p>
    <p class="tagline">Pesquisa, ensino e pontes entre o conhecimento formal e o setor privado.</p>
    <p class="bio">Sou doutorando em Relações Internacionais pela Universidade de Brasília (IREL/UnB), investigando a política planetária e os limites metateoréticos das RI como disciplina. Sou bacharel em Relações Internacionais (UnB) e em Ciência de Dados (Estácio), e atuo como Consultor Político e de Dados na BMJ Consultores Associados — liderando o produto BMJ Digital, que combina ciência de dados, OSINT e análise de discurso.</p>
    <div class="hero-links">
      <a href="/pt/research" class="link-arrow">Pesquisa →</a>
      <a href="/pt/cv" class="link-arrow">Currículo →</a>
      <a href="mailto:contact@jalescaur.com" class="link-arrow link-muted">contact@jalescaur.com</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Trabalhos selecionados</h2>
      <a href="/pt/research#publications" class="see-all">Ver todas as publicações →</a>
    </div>
    <div class="work-list">
      <div class="work-item">
        <div class="work-meta">Tese de doutorado &middot; IREL/UnB &middot; em andamento</div>
        <h3><a href="/pt/research">Política Planetária: Um Além para as Relações Internacionais?</a></h3>
        <p>Orientada pela Profa. Dra. Cristina Yumie Aoki Inoue. A partir da MSRP de Lakatos, examina se os frameworks de política planetária constituem uma ruptura metateorérica genuína nas RI.</p>
      </div>
      <div class="work-item">
        <div class="work-meta">Consultor &middot; BMJ Consultores Associados &middot; 2024&ndash;presente</div>
        <h3>BMJ Digital</h3>
        <p>Análise política e monitoramento de risco digital — ciência de dados, OSINT e análise de discurso aplicadas à inteligência de risco político e setorial.</p>
      </div>
      <div class="work-item">
        <div class="work-meta">Resenha &middot; International Affairs &middot; 2026</div>
        <h3><a href="/pt/research#publications">Resenha de Ulf Hedetoft, <em>The Morality of Politics: States, Honour and War</em></a></h3>
        <p>Publicada em <em>International Affairs</em>, v. 102, p. 712–714.</p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="section-head">
      <h2>Do blog</h2>
      <a href="/pt/blog" class="see-all">Todos os posts →</a>
    </div>
    <div class="blog-cards">
      {recentPosts.map(post => (
        <a href={`/blog/${post.id}`} class="blog-card">
          <div class="blog-card-date">{post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
          <div class="blog-card-title">{post.data.title}</div>
          {post.data.description && <div class="blog-card-desc">{post.data.description}</div>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-top: -3rem;
    height: 58vh;
    min-height: 420px;
    max-height: 620px;
    overflow: hidden;
    background: var(--cream-dark);
  }

  .banner img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    filter: grayscale(1) contrast(1.15) brightness(1.03);
    display: block;
  }

  .banner-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17, 17, 17, 0) 55%, var(--cream) 100%);
  }

  .hero { padding: 3.5rem 0 4rem; max-width: 780px; }

  h1 { margin-bottom: 0.6rem; color: var(--ink); font-family: var(--font-name); font-weight: 400; font-size: clamp(2.75rem, 6vw, 4.25rem); }
  h1 em { font-style: normal; color: var(--accent); }

  .role-line {
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: var(--ink-light);
    margin-bottom: 1.5rem;
    max-width: 620px;
    line-height: 1.5;
  }

  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--ink-mid);
    margin-bottom: 1.75rem;
    line-height: 1.5;
    display: block;
  }

  .bio { font-size: 1.02rem; margin-bottom: 2.25rem; max-width: 640px; }

  .hero-links { display: flex; gap: 0.5rem 1.75rem; flex-wrap: wrap; align-items: baseline; }

  .link-arrow {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }
  .link-arrow:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .link-arrow.link-muted { color: var(--ink-light); border-color: var(--rule); font-weight: 500; }
  .link-arrow.link-muted:hover { color: var(--accent); border-color: var(--accent); }

  .section { padding: 2.5rem 0; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .section-head h2 { margin-bottom: 0; }
  .see-all {
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-light);
    white-space: nowrap;
  }
  .see-all:hover { color: var(--accent); text-decoration: none; }

  .work-list { display: flex; flex-direction: column; }
  .work-item {
    padding: 1.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .work-item:last-child { padding-bottom: 0; }

  .work-meta {
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-light);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .work-item h3 { margin-bottom: 0.5rem; font-size: 1.25rem; }
  .work-item h3 a { color: var(--ink); }
  .work-item h3 a:hover { color: var(--accent); text-decoration: none; }
  .work-item p { font-size: 0.95rem; max-width: 680px; }

  .blog-cards { display: flex; flex-direction: column; gap: 0; }
  .blog-card {
    display: block;
    padding: 1.25rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: padding-left 0.2s ease;
  }
  .blog-card:last-child { border-bottom: 1px solid var(--rule); }
  .blog-card:hover { padding-left: 0.5rem; text-decoration: none; }
  .blog-card-date { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.3rem; }
  .blog-card-title { font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--ink); margin-bottom: 0.2rem; transition: color 0.15s; }
  .blog-card:hover .blog-card-title { color: var(--accent); }
  .blog-card-desc { font-size: 0.85rem; color: var(--ink-light); }

  @media (max-width: 720px) {
    .banner { height: 44vh; min-height: 320px; }
    .section-head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>
