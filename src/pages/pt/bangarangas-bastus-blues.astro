    { id: 'origins', title: 'Origens institucionais' },
    { id: 'rules', title: 'Mecânica e regras do concurso' },
    { id: 'voting-history', title: 'Sistemas de votação, 1956–2015' },
    { id: 'voting-since-2016', title: 'Votação e apresentação desde 2016' },
  ] },
  { title: 'Parte II · Os dados, 2016–2026', sections: [
    { id: 'scoreboard', title: 'O placar' },
    { id: 'electorates', title: 'Dois eleitorados' },
    { id: 'predictors', title: 'O que prevê os pontos' },
    { id: 'blocs', title: 'Voto em bloco' },
    { id: 'affinity', title: 'O mapa de afinidades' },
    { id: 'network', title: 'A rede' },
    { id: 'shocks', title: 'Choques: estudos de caso, 2016–2026' },
  ] },
