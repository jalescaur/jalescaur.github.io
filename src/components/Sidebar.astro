---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const enPath = lang === 'pt' ? (currentPath.replace(/^\/pt/, '') || '/') : currentPath;
const ptPath = lang === 'en' ? `/pt${currentPath === '/' ? '' : currentPath}` : currentPath;

const rawPath = currentPath.replace(/^\/pt/, '') || '/';

const navItems = [
  { href: getLocalizedPath('/', lang), label: t('nav.home'), match: '/' },
  { href: getLocalizedPath('/research', lang), label: t('nav.research'), match: '/research' },
  { href: getLocalizedPath('/cv', lang), label: t('nav.cv'), match: '/cv' },
  { href: getLocalizedPath('/blog', lang), label: t('nav.blog'), match: '/blog' },
];
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <a href={getLocalizedPath('/', lang)} class="identity">
      <span class="identity-name">Jales Caur</span>
      <span class="identity-role">PhD(c) &middot; IR &amp; Data</span>
    </a>

    <nav aria-label="Primary">
      <ol>
        {navItems.map((item, i) => {
          const isActive = item.match === '/' ? rawPath === '/' : rawPath.startsWith(item.match);
          return (
            <li>
              <a href={item.href} aria-current={isActive ? 'page' : undefined} class:list={{ active: isActive }}>
                <span class="nav-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="nav-label">{item.label}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>

    <div class="sidebar-foot">
      <div class="social-row">
        <a href="https://www.linkedin.com/in/jalescaur/" target="_blank" rel="noopener" aria-label="LinkedIn" class="icon-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/jales.caur/" target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.16c3.2 0 3.58.012 4.85.07 1.17.054 1.8.249 2.23.415.56.217.96.477 1.38.896.42.42.68.819.9 1.381.16.422.36 1.057.41 2.227.06 1.266.07 1.646.07 4.85s-.01 3.585-.07 4.85c-.05 1.17-.25 1.805-.41 2.227-.22.562-.48.96-.9 1.382-.42.419-.82.679-1.38.896-.43.164-1.06.36-2.23.413-1.27.057-1.65.07-4.85.07s-3.59-.013-4.86-.07c-1.17-.053-1.8-.249-2.23-.413a3.7 3.7 0 0 1-1.38-.896 3.7 3.7 0 0 1-.9-1.382c-.16-.422-.36-1.057-.41-2.227-.06-1.265-.07-1.646-.07-4.85s.01-3.584.07-4.85c.05-1.17.25-1.805.41-2.227a3.68 3.68 0 0 1 .9-1.381 3.7 3.7 0 0 1 1.38-.896c.43-.166 1.06-.361 2.23-.415 1.27-.058 1.65-.07 4.86-.07M12 0C8.74 0 8.33.015 7.05.072 5.78.132 4.9.333 4.14.63a5.87 5.87 0 0 0-2.13 1.384A5.85 5.85 0 0 0 .63 4.14C.33 4.905.13 5.775.07 7.053.01 8.333 0 8.74 0 12s.01 3.667.07 4.947c.06 1.277.26 2.148.56 2.913a5.9 5.9 0 0 0 1.38 2.126 5.87 5.87 0 0 0 2.13 1.384c.76.296 1.63.499 2.91.558C8.33 23.988 8.74 24 12 24s3.67-.015 4.95-.072c1.28-.06 2.15-.262 2.91-.558a5.9 5.9 0 0 0 2.13-1.384 5.9 5.9 0 0 0 1.38-2.126c.3-.765.5-1.636.56-2.913.06-1.28.07-1.687.07-4.947s-.01-3.667-.07-4.947c-.06-1.277-.26-2.149-.56-2.913a5.87 5.87 0 0 0-1.38-2.126A5.85 5.85 0 0 0 19.86.63c-.76-.297-1.63-.499-2.91-.558C15.67.012 15.26 0 12 0m0 5.838a6.16 6.16 0 1 0 0 12.324 6.16 6.16 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m7.85-10.405a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0"/>
          </svg>
        </a>
        <a href="http://lattes.cnpq.br/9989811261390202" target="_blank" rel="noopener" class="lattes-badge">Lattes</a>
      </div>

      <div class="lang-switcher">
        <a href={enPath} class:list={{ active: lang === 'en' }}>EN</a>
        <span class="lang-sep" aria-hidden="true">&middot;</span>
        <a href={ptPath} class:list={{ active: lang === 'pt' }}>PT</a>
      </div>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    border-right: 1px solid var(--ink-18);
  }

  .sidebar-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 3rem 2rem;
  }

  .identity {
    display: block;
    text-decoration: none;
    margin-bottom: 3.5rem;
  }
  .identity-name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--ink);
  }
  .identity-role {
    display: block;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-35);
    margin-top: 0.35rem;
  }

  nav ol {
    list-style: none;
  }
  nav li + li {
    margin-top: 1rem;
  }
  nav a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }
  .nav-index {
    font-family: var(--font-label);
    font-size: 0.72rem;
    color: var(--ink-35);
    font-variant-numeric: tabular-nums;
  }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--ink-55);
    transition: color 0.15s;
  }
  nav a:hover .nav-label,
  nav a:hover .nav-index {
    color: var(--ink);
  }
  nav a.active .nav-label {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  nav a.active .nav-index {
    color: var(--ink);
  }

  .sidebar-foot {
    margin-top: auto;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .social-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .icon-link {
    color: var(--ink-35);
    display: flex;
  }
  .icon-link:hover {
    color: var(--ink);
  }
  .lattes-badge {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-35);
    text-decoration: none;
  }
  .lattes-badge:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .lang-switcher a {
    color: var(--ink-35);
    text-decoration: none;
  }
  .lang-switcher a.active {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .lang-switcher a:hover {
    color: var(--ink);
  }
  .lang-sep {
    color: var(--ink-18);
  }

  @media (max-width: 900px) {
    .sidebar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--ink-18);
    }
    .sidebar-inner {
      padding: 1.25rem 1.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 2rem;
    }
    .identity { margin-bottom: 0; }
    nav ol { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; }
    nav li + li { margin-top: 0; }
    .sidebar-foot {
      margin-top: 0;
      margin-left: auto;
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      padding-top: 0;
    }
  }
</style>
